# Copia este archivo como .env y pon tus datos. El .env real no se sube a git.

# Conexión de la aplicación a PostgreSQL. Usa un usuario miembro de
# larafarma_app (ver docs/instalacion.md), nunca el dueño de las tablas:
# el dueño se salta las reglas de seguridad.
DATABASE_URL=postgresql://larafarma_web:CONTRASEÑA@localhost:5432/larafarma

# Opcional: "Subir datos" a la nube (Configuración). Supabase → Project Settings → API.
# La clave de servicio se salta todas las reglas: solo en el servidor, nunca con NEXT_PUBLIC_.
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
