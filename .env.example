# Copia este archivo como .env y pon tus datos (Supabase → Project Settings → API).
# El .env real no se sube a git.

# Públicas: van al navegador. Solo permiten lo que dejan las reglas RLS.
NEXT_PUBLIC_SUPABASE_URL="https://TU-PROYECTO.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# Secreta: se salta RLS. Solo la usa el servidor para crear y bloquear cuentas.
# Nunca le pongas NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY="..."
